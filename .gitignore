# Ключи и секреты — не коммитить
.env
backend/.env
*.env
!.env.example
!backend/.env.example

# macOS metadata (не должны попадать в архивы и на сервер)
.DS_Store
**/.DS_Store
._*
**/._*

# Python
**/__pycache__/
**/*.pyc
**/*.pyo

# Node / frontend build artifacts
**/node_modules/
# dist коммитим — на сервере нет Node, Caddy отдаёт статику из frontend/dist
# frontend/dist/

# Playwright WB session snapshot (secret)
backend/wb_storage_state.json
backend/data/playwright_debug/
backend/data/wb_storage_states/
frontend/test-results/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local-only test credentials (never commit)
.local-test-creds.txt

# Бот поддержки клиентов (tools/support_bot): конфиг с токенами и переписка с клиентами
# не коммитятся, даже если кто-то укажет папку состояния внутри репозитория.
tools/support_bot/config.json
tools/support_bot/state/
tools/support_bot/.venv/
**/wbf-support-bot-state/
**/.wbf-support-bot/
**/state.db
**/state.db-wal
**/state.db-shm
**/watch.last
**/watch.last.tmp
**/promise_alerts.json
**/promise_alerts.json.tmp

# Кэши инструментов
.pytest_cache/
.ruff_cache/
